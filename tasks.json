{
  "project": {
    "name": "XenoCRM",
    "description": "AI-native mini CRM for consumer brands",
    "brand": {
      "name": "Thread & Co.",
      "tagline": "Indian fashion brand — casual but premium",
      "locale": "en-IN",
      "currency": "INR",
      "currencySymbol": "₹"
    },
    "version": "1.0.0",
    "prdFile": "XenoCRM_PRD.md"
  },
  "decisions": {
    "ai": {
      "provider": "Google Gemini 2.5 Flash",
      "model": "gemini-2.5-flash",
      "sdk": "Vercel AI SDK",
      "envVar": "GEMINI_API_KEY",
      "streaming": true,
      "proactiveInsights": "rules-based SQL + optional LLM polish on one primary insight"
    },
    "architecture": {
      "monorepo": "pnpm workspaces + Turborepo",
      "services": ["apps/web", "apps/crm-api", "apps/channel-stub"],
      "sharedPackage": "packages/shared",
      "twoServiceRequired": true,
      "stubSecretHeader": "STUB_SECRET"
    },
    "stack": {
      "frontend": "Next.js 14 App Router + Tailwind + shadcn/ui + TanStack Query",
      "crmBackend": "Node.js + Fastify + TypeScript",
      "channelStub": "Node.js + Fastify + TypeScript",
      "database": "PostgreSQL (Neon)",
      "orm": "Prisma",
      "validation": "Zod",
      "realtime": "Socket.io",
      "charts": "Recharts",
      "hosting": {
        "web": "Vercel",
        "crmApi": "Railway",
        "channelStub": "Railway"
      }
    },
    "tagThresholds": {
      "NEW": "first purchase < 30 days OR only 1 order",
      "VIP": "top 10% by total spend",
      "LAPSED": "no purchase in 60+ days",
      "AT_RISK": "30-60 days since last purchase AND spend declining",
      "REGULAR": "everything else"
    },
    "campaignRules": {
      "simultaneousCampaigns": true,
      "confirmationGate": "intent classification + server-side confirmation flag before fireCampaign",
      "personalization": "template + rules only ({name} + VIP tone variant, no per-recipient LLM)",
      "rerunCampaign": "new conversation thread with segment + message injected as system context"
    },
    "enhancements": [
      "Campaign draft object persisted before confirmation",
      "Rules-based insights + LLM polish",
      "Recipient status state machine",
      "SEED_ONLY env flag for reproducible demo data"
    ]
  },
  "phases": [
    {
      "id": "foundation",
      "name": "Foundation",
      "order": 1
    },
    {
      "id": "backend-crm",
      "name": "Backend (CRM API)",
      "order": 2
    },
    {
      "id": "backend-stub",
      "name": "Backend (Channel Stub)",
      "order": 3
    },
    {
      "id": "frontend",
      "name": "Frontend",
      "order": 4
    },
    {
      "id": "ai-layer",
      "name": "AI Layer",
      "order": 5
    },
    {
      "id": "polish",
      "name": "Polish",
      "order": 6
    }
  ],
